# Backend
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Primary LLM provider: gemini, groq, openai, offline.
# If the primary fails (bad key, quota, outage) the fallback provider is used automatically.
# Providers without an API key are skipped.
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TIMEOUT_SECONDS=45
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Keep true for local demos; set false in production when a real provider key is configured
OFFLINE_FALLBACK=true

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_CROSS_ENCODER=true
DEFAULT_TOP_K_INITIAL=20
DEFAULT_TOP_K_FINAL=5
DEFAULT_SEMANTIC_WEIGHT=0.7
DEFAULT_KEYWORD_WEIGHT=0.3
MAX_CONTEXT_TOKENS=4200

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
# development: false is OK; production/staging: set true
AUTH_REQUIRED=false

# Startup — development auto-seeds shared samples when the DB has none.
# production: set true only if you want sample docs in that environment.
AUTO_INGEST_SAMPLE_DOCS=false
EVAL_PASS_THRESHOLD=0.72

# Optional contact form email delivery (messages are always stored in DB)
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=

# Frontend (also set in frontend/.env.local for Next.js builds)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
